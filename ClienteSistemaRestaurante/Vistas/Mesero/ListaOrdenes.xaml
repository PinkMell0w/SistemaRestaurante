<Page x:Class="ClienteSistemaRestaurante.Vistas.Mesero.ListaOrdenes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Mesero"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Órdenes que atiendo" Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10">
            <Run Text="Órdenes del día -"/>
            <Run x:Name="runDia"/>
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icOrdenes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,10" CornerRadius="5" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Orden #" FontWeight="Normal"/>
                                    <Run Text="{Binding idOrden}"/>
                                    <Run Text="- Mesa" FontWeight="Normal"/>
                                    <Run Text="{Binding Mesa.numero}" FontWeight="Normal"/>
                                </TextBlock>

                                <Button Grid.Column="1" Content="Actualizar" Margin="10,0" Padding="10,5" Background="#D1D1D1" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnActualizarOrden_Click" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Grid.Row="2" Background="#DDDDDD"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button Content="Volver" Width="120" Height="40" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnVolver_Click"/>
        </StackPanel>
    </Grid>
</Page>
