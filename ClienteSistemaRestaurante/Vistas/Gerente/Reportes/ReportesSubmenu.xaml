<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Reportes.ReportesSubmenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Reportes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="ReportesSubmenu" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Módulo de Reportes" FontSize="24" FontWeight="Bold"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnGenerarReporte_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/CrearOrden.png" Stretch="None" />
                    <TextBlock Text="Generar reporte" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnVerHistorico_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/ConsultarOrdenes.png" Stretch="None" />
                    <TextBlock Text="Ver histórico" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Page>
