<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Inventario.Ingredientes.IngredientesSubmenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Inventario.Ingredientes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Inventario - Ingredientes" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ingredientes" FontSize="24" FontWeight="Bold"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnAgregarIngrediente_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/RegistrarIngrediente.png" Stretch="None" />
                    <TextBlock Text="Agregar Ingrediente" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnConsultarIngredientes_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/Ingredientes.png" Stretch="None" />
                    <TextBlock Text="Consultar Ingredientes" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Button Grid.Row="2" Content="Volver" Width="120" Height="40" HorizontalAlignment="Left" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnVolver_Click"/>
    </Grid>
</Page>
