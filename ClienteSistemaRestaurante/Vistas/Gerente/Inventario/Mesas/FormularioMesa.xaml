<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Inventario.Mesas.FormularioMesa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Inventario.Mesas"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="FormularioMesa" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="10"/>

        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="txtNumeroBlock" Text="Número*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNumero" Text="Ej.: 1" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                <TextBlock x:Name="txtNumeroRestriccion" Text="Sólo números enteros" FontSize="8"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="txtCapacidadBlock" Text="Capacidad*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCapacidad" Text="Ej.: 4" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                <TextBlock x:Name="txtCapacidadRestriccion" Text="Sólo números enteros - 1 a 8" FontSize="8"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Los campos marcados con * son obligatorios." FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="120" Height="40" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button x:Name="btnGuardar" Width="120" Height="40" Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="BtnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
