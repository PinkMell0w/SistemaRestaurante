<Page x:Class="ClienteSistemaRestaurante.Vistas.Mesero.ListaDetallesOrden"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Mesero"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListaDetallesOrden" Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtDetalleOrden" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icDetalles">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,10" CornerRadius="5" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="{Binding Platillo.nombre}" FontWeight="Normal"/>
                                    <Run Text="-"/>
                                    <Run Text="{Binding cantidadPlatillo}" FontWeight="Normal"/>
                                    <Run Text="-" FontWeight="Normal"/>
                                    <Run Text="{Binding estado}" FontWeight="Normal"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Grid.Row="2" Background="#DDDDDD"/>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Volver" Width="120" Height="40" Background="#FFD1D1D1" HorizontalAlignment="Left" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnVolver_Click"/>
            <Button Content="Agregar platillo(s)" Width="140" Height="40" Background="#E36D2D" Foreground="White" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnAgregarPlatillos_Click"/>
        </Grid>
    </Grid>
</Page>
