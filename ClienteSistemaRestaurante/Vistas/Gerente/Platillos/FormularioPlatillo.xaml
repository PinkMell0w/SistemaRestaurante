<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Platillos.FormularioPlatillo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Platillos"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="FormularioPlatillo" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="txtNombreBlock" Text="Nombre*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNombre" Text="Ej.: Milanesa de pollo" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                <TextBlock x:Name="txtNombreRestriccion" Text="Máximo 45 caracteres (sólo letras)" FontSize="8"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="txtCostoBlock" Text="Costo*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="$" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" x:Name="txtCosto" Text="Ej.: 150" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                </Grid>
                <TextBlock x:Name="txtCostoRestriccion" Text="Sólo números enteros" FontSize="8"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock x:Name="txtCategoriaBlock" Text="Categoría*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbCategoria" FontSize="14" Padding="4" HorizontalAlignment="Stretch" SelectionChanged="CbCategoria_SelectionChanged">
                    <ComboBoxItem Content="-- Seleccione una --" IsSelected="True"/>
                    <ComboBoxItem Content="Alimento"/>
                    <ComboBoxItem Content="Bebida"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="6">
                <TextBlock x:Name="txtTipoBlock" Text="Tipo*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbTipo" FontSize="14" Padding="4" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="-- Seleccione categoría --" IsSelected="True"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="txtDescripcionBlock" Text="Descripción*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescripcion" Text="Ej.: Milanesa de pollo con papas" FontSize="14" Height="65" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus" TextChanged="TxtDescripcion_TextChanged" MaxLength="255" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <TextBlock x:Name="txtDescRestriccion" Text="255 caracteres restantes" FontSize="8"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="txtEstadoBlock" Text="Estado*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbEstado" FontSize="14" Padding="4" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="-- Seleccione uno --" IsSelected="True"/>
                    <ComboBoxItem Content="Disponible"/>
                    <ComboBoxItem Content="No disponible"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" x:Name="txtIngredientesBlock" Text="Ingredientes*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="icIngredientes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" FontSize="14" Padding="4" ItemsSource="{Binding ListaIngredientes}" SelectedItem="{Binding IngredienteSeleccionado}" DisplayMemberPath="nombre" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="Cantidad:" FontSize="14" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="2" FontSize="14" Padding="4" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="3" Text="{Binding UnidadMedida}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Button Grid.Column="4" Content="-" Width="30" Height="30" Background="#EB2A2A" Foreground="White" FontSize="14" FontWeight="Bold" Padding="4" Cursor="Hand" Click="BtnEliminarIngrediente_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+" Width="30" Height="30" HorizontalAlignment="Left" Background="#2A8A2A" Foreground="White" FontSize="14" FontWeight="Bold" Padding="4" Cursor="Hand" Click="BtnAgregarIngrediente_Click"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Row="5" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Los campos marcados con * son obligatorios." FontSize="12" Margin="10"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="120" Height="40" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button x:Name="btnGuardarPlatillo" Width="150" Height="40" Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="BtnGuardarPlatillo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
