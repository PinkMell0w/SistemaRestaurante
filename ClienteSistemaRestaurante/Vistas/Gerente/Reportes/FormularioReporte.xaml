<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Reportes.FormularioReporte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Reportes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="FormularioReporte" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Text="Generar reporte" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <StackPanel Width="260" HorizontalAlignment="Left" Margin="0,0,0,25">
                    <TextBlock x:Name="txtTipoBlock" Text="Tipo*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbTipo" FontSize="14" Padding="4" HorizontalAlignment="Stretch" SelectionChanged="CbTipo_SelectionChanged">
                        <ComboBoxItem Content="-- Seleccione uno --" IsSelected="True"/>
                        <ComboBoxItem Content="Diario"/>
                        <ComboBoxItem Content="Semanal"/>
                        <ComboBoxItem Content="Mensual"/>
                    </ComboBox>
                </StackPanel>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtFechaInicioBlock" Text="Fecha de inicio*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaInicio"
                                    FontSize="14"
                                    Padding="4"
                                    IsEnabled="False"
                                    SelectedDateChanged="DpFechaInicio_SelectedDateChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="txtFechaFinBlock" Text="Fecha de fin*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpFechaFin"
                                    FontSize="14"
                                    Padding="4"
                                    IsEnabled="False"
                                    Focusable="False"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Los campos marcados con * son obligatorios." FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="120" Height="40" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button x:Name="btnGenerarReporte" Content="Generar reporte" Width="150" Height="40" Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="BtnGenerarReporte_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
