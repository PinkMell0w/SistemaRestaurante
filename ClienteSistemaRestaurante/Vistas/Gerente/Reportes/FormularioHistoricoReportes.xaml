<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Reportes.FormularioHistoricoReportes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Reportes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="FormularioHistoricoReportes" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ver histórico de reportes" Grid.Row="0" FontSize="22" FontWeight="Bold" Margin="15,12,15,6"/>

        <Grid Grid.Row="1" Margin="15,5,15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Width="155" Margin="0,0,12,8">
                    <TextBlock Text="Tipo" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbTipo" FontSize="13" Padding="4" SelectionChanged="CbTipo_SelectionChanged">
                        <ComboBoxItem Content="-- Seleccione uno --" IsSelected="True"/>
                        <ComboBoxItem Content="Diario"/>
                        <ComboBoxItem Content="Semanal"/>
                        <ComboBoxItem Content="Mensual"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,12,8">
                    <TextBlock Text="Fecha de inicio" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpFechaInicio" FontSize="13" Padding="3" SelectedDateChanged="DpFechaInicio_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Width="140" Margin="0,0,12,8">
                    <TextBlock Text="Fecha de fin" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpFechaFin" FontSize="13" Padding="3" IsEnabled="False" Focusable="False"/>
                </StackPanel>

                <StackPanel Width="170" Margin="0,0,12,8">
                    <TextBlock Text="Mesero" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbMesero" FontSize="13" Padding="4" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Width="170" Margin="0,0,12,8">
                    <TextBlock Text="Platillo" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbPlatillo" FontSize="13" Padding="4" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Consultar reportes" Height="30" Padding="12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnConsultarReportes_Click"/>
                </StackPanel>
            </WrapPanel>

            <Border x:Name="borderGraficaContainer" Grid.Row="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="txtTituloGrafica" Text="Ventas" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="txtResumenTotal" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Border x:Name="graficaCapturable" Grid.Row="1" Background="White" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Ventas ($)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>

                            <ItemsControl x:Name="icBarras" Grid.Column="1" VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0" VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding ValorTexto}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                                                <Border Height="{Binding AlturaBarra}" Background="#E36D2D" CornerRadius="2,2,0,0" HorizontalAlignment="Stretch" ToolTip="{Binding Etiqueta}"/>
                                            </Border>

                                            <TextBlock Grid.Row="2" Text="{Binding Etiqueta}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancelar" Grid.Column="0" HorizontalAlignment="Left" Width="120" Height="40" Margin="15,10" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>

            <Button Content="Guardar reporte" Grid.Column="1" HorizontalAlignment="Right" Width="150" Height="40" Margin="15,10" Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnGuardarReporte_Click"/>
        </Grid>
    </Grid>
</Page>
