<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Empleados.EmpleadosSubmenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Empleados"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Módulo de Empleados" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Módulo de Empleados" FontSize="24" FontWeight="Bold"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnAgregarEmpleado_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/RegistrarEmpleado.png" Stretch="None" />
                    <TextBlock Text="Agregar Empleado" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Margin="15" FontSize="16" FontWeight="Bold" Background="#E36D2D" Foreground="White" Cursor="Hand" Click="BtnConsultarEmpleados_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/ConsultarEmpleados.png" Stretch="None" />
                    <TextBlock Text="Consultar Empleados" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Page>
