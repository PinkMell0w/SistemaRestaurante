<Page x:Class="ClienteSistemaRestaurante.Vistas.Cajero.MenuCajero"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Cajero"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Sistema de Gestión de Restaurante" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="24" Margin="10,10,10,0" FontWeight="Bold">
            <Run Text="Bienvenido(a)," FontWeight="Bold"/>
            <Run x:Name="runNombreCompleto"/>
        </TextBlock>

        <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Button Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnGenerarPago_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/CrearOrden.png" Stretch="None" />
                    <TextBlock Text="Generar pago" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Margin="20,0,0,0" Click="BtnVerPagos_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/ConsultarOrdenes.png" Stretch="None" />
                    <TextBlock Text="Ver pagos generados" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Button Grid.Row="2" Content="Cerrar sesión" Margin="10,0,0,10" HorizontalAlignment="Left" Width="120" Height="35" Background="#FFB60707" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnCerrarSesion_Click"/>
    </Grid>
</Page>
