<Page x:Class="ClienteSistemaRestaurante.Vistas.Cajero.ResumenOrden"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Cajero"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="ResumenOrden" Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtDesgloseConsumo" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icDetalles">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,0,10" CornerRadius="5" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Nombre del platillo:"/>
                                    <Run Text="{Binding Platillo.nombre}" FontWeight="Normal"/>
                                    <Run Text=", Cantidad:"/>
                                    <Run Text="{Binding cantidadPlatillo}" FontWeight="Normal"/>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Precio unitario: $"/>
                                    <Run Text="{Binding precioUnitario}"/>
                                    <Run Text=", Subtotal: $"/>
                                    <Run Text="{Binding subtotal}" FontWeight="Normal"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Grid.Row="2" Background="#DDDDDD"/>

        <Grid Grid.Row="3" VerticalAlignment="Center" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Método de pago: " FontSize="16"/>
                <ComboBox x:Name="cbMetodoPago" FontSize="14" Padding="4" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="-- Seleccione uno --" IsSelected="True"/>
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Transferencia"/>
                    <ComboBoxItem Content="Terminal"/>
                </ComboBox>

                <TextBlock FontSize="16" Margin="20,0,0,0">
                    <Run Text="Mesero que atendió:"/>
                    <Run x:Name="txtNombreMesero"/>
                </TextBlock>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Subtotal: $" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtotal" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="IVA: $" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="txtIva" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Total: $" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotal" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="4" Margin="0,10,0,10" Background="#DDDDDD"/>

        <Grid Grid.Row="5" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="120" Height="40" Background="#FFD1D1D1" HorizontalAlignment="Left" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button Content="Generar ticket" Width="120" Height="40" Background="#E36D2D" Foreground="White" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnGenerarPago_Click"/>
        </Grid>
    </Grid>
</Page>
