<Page x:Class="ClienteSistemaRestaurante.Vistas.Mesero.FormularioOrden"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Mesero"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FormularioOrden" Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtOrden" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
            <Run Text="Fecha de hoy:"/>
            <Run x:Name="runFechaHoy"/>
        </TextBlock>
        
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2">
            <TextBlock Text="Buscar platillos: " FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="txtBuscar" Text="{Binding TextoBuscar, UpdateSourceTrigger=PropertyChanged}" TextChanged="txtBuscar_TextChanged" FontSize="14" Padding="4" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
        
        <Separator Grid.Row="3" Margin="0,10,0,10" Background="#DDDDDD"/>

        <TextBlock Grid.Row="4" Text="Platillos de la orden:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="5">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Alimentos" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                <ItemsControl x:Name="icAlimentos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#AB3C00" BorderThickness="1" CornerRadius="5" Width="170" Height="80" Margin="5" Padding="5" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Platillo.nombre}" TextWrapping="Wrap" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="{Binding TextoBoton}" IsEnabled="{Binding EsHabilitado}" Width="80" Height="28" Background="{Binding ColorBoton}" Foreground="{Binding ColorTexto}" Cursor="Hand" Tag="{Binding}" Click="BtnAgregar_Click"/>
                                        <TextBox Text="{Binding CantidadInput, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="28" Margin="5,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Bebidas" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                <ItemsControl x:Name="icBebidas">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#AB3C00" BorderThickness="1" CornerRadius="5" Width="170" Height="80" Margin="5" Padding="5" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Platillo.nombre}" TextWrapping="Wrap" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="{Binding TextoBoton}" IsEnabled="{Binding EsHabilitado}" Width="80" Height="28" Background="{Binding ColorBoton}" Foreground="{Binding ColorTexto}" Cursor="Hand" Tag="{Binding}" Click="BtnAgregar_Click"/>
                                        <TextBox Text="{Binding CantidadInput, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="28" Margin="5,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
        
        <Separator Grid.Row="6" Margin="0,10,0,10" Background="#DDDDDD"/>

        <StackPanel Grid.Row="7" Margin="0,0,0,15" Width="300" HorizontalAlignment="Left">
            <TextBlock Text="Mesa:" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbMesas" FontSize="14" Padding="4" HorizontalAlignment="Stretch" DisplayMemberPath="numero" SelectedValuePath="idMesa"/>
        </StackPanel>

        <Grid Grid.Row="8" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="150" Height="30" HorizontalAlignment="Left" Background="#FFD1D1D1" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button x:Name="btnGuardar" Width="150" Height="30" HorizontalAlignment="Right" Background="#E36D2D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnGuardarOrden_Click"/>
        </Grid>
    </Grid>
</Page>
