<Page x:Class="ClienteSistemaRestaurante.Vistas.Gerente.Empleados.FormularioEmpleado"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente.Empleados"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="FormularioEmpleado" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtNombreBlock" Text="Nombre(s)*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNombres" Text="Ej.: Roberto Carlos" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                        <TextBlock x:Name="txtNombreRestriccion" Text="Máximo 45 caracteres (sólo letras)" FontSize="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="txtApellidoPaternoBlock" Text="Apellido Paterno*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtApellidoPaterno" Text="Ej.: Pérez" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                        <TextBlock x:Name="txtApellidoPatRestriccion" Text="Máximo 45 caracteres (sólo letras)" FontSize="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Apellido Materno" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtApellidoMaterno" Text="Ej.: Martínez" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                        <TextBlock x:Name="txtApellidoMatRestriccion" Text="Máximo 45 caracteres (sólo letras)" FontSize="8"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock x:Name="txtRFCBlock" Text="RFC*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRFC" Text="Ej.: PEMR980623HJ9" FontSize="14" Padding="4" Foreground="Gray" HorizontalAlignment="Stretch" GotFocus="LimpiarPlaceholder_Focus" LostFocus="RestaurarPlaceholder_LostFocus"/>
                        <TextBlock x:Name="txtRfcRestriccion" Text="Máximo 13 caracteres (sólo mayúsculas y números)" FontSize="8"/>
                    </StackPanel>
                </Grid>

                <StackPanel Width="Auto" HorizontalAlignment="Left" Margin="0,0,0,25">
                    <TextBlock x:Name="txtRolBlock" Text="Rol*" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbRol" FontSize="14" Padding="4" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="-- Seleccione uno --" IsSelected="True"/>
                        <ComboBoxItem Content="Cajero"/>
                        <ComboBoxItem Content="Mesero"/>
                        <ComboBoxItem Content="Cocinero"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Los campos marcados con * son obligatorios." FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="120" Height="40" Background="#FFD1D1D1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button x:Name="btnGuardar" Width="120" Height="40" Background="#E36D2D" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand" Click="BtnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
