<Window x:Class="ClienteSistemaRestaurante.Vistas.Gerente.VistaGerente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClienteSistemaRestaurante.Vistas.Gerente"
        mc:Ignorable="d"
        Title="Sistema de Gestión de Restaurante" Height="650" Width="1000" Background="#F5EDE1"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E36D2D" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Menú rápido" FontSize="16" FontWeight="Bold" Foreground="White" Margin="5"/>
                    <Button Content="Empleados" Height="45" Background="Transparent" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnEmpleados_Click"/>
                    <Button Content="Platillos" Height="45" Background="Transparent" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnPlatillos_Click"/>
                    <Button Content="Inventario" Height="45" Background="Transparent" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnInventario_Click"/>
                    <Button Content="Reportes" Height="45" Background="Transparent" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnReportes_Click"/>
                </StackPanel>


                <Button Grid.Row="1" Content="Cerrar sesión" Height="45" Background="#FFB60707" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnCerrarSesion_Click"/>
            </Grid>
        </Border>
        
        <Frame x:Name="MainContentArea" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="20"/>
    </Grid>
</Window>
